#!/usr/bin/env python3
"""Deterministic stand-in for the Codex CLI, speaking the JSONL protocol of codex-cli 0.163.

FAKE_CODEX_SCENARIO: comma-separated scenarios, one per invocation (last one repeats):
  ok | blocked | quota | auth | network | crash | hang | commit | outside | nojson
FAKE_CODEX_WRITE: "path=content;path2=content" (or "@file" holding that) written on ok runs.
FAKE_CODEX_DIR:   scratch dir for the call counter, argv/prompt log and the hang child's pid.
FAKE_CODEX_DECISION: "decision:notes" a reviewer run returns (default "approve:looks good").
FAKE_CODEX_PLAN:  JSON list of tasks a planner run returns (default: one task).
Runs answer the --output-schema they get (executor, reviewer or planner); read-only runs never
write files, as the real sandbox would refuse.
"""

import atexit
import hashlib
import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

argv = sys.argv[1:]
if argv[:1] in (["--version"],):
    print("codex-cli 0.0.0-fake")
    sys.exit(0)
if argv[:2] == ["login", "status"]:
    if os.environ.get("CODEX_HOME") and not (Path(os.environ["CODEX_HOME"]) / "auth.json").exists():
        print("Not logged in")
        sys.exit(1)
    print("Logged in using ChatGPT (fake)")
    sys.exit(0)

state = Path(os.environ["FAKE_CODEX_DIR"])
state.mkdir(parents=True, exist_ok=True)
counter = state / "calls"
n = int(counter.read_text()) if counter.exists() else 0
counter.write_text(str(n + 1))
scenarios = os.environ.get("FAKE_CODEX_SCENARIO", "ok").split(",")
scenario = scenarios[min(n, len(scenarios) - 1)]

prompt = sys.stdin.read()
entry = {"argv": argv, "prompt": prompt, "cwd": os.getcwd(),
         "codex_home": os.environ.get("CODEX_HOME"),
         "env_has_secret": "OPENAI_API_KEY" in os.environ, "t_start": time.time()}


def log_run():
    with (state / "log.jsonl").open("a") as f:
        f.write(json.dumps({**entry, "t_end": time.time()}) + "\n")


atexit.register(log_run)

resume = argv[:2] == ["exec", "resume"]
thread = argv[-2] if resume else str(uuid.uuid4())
out_file = argv[argv.index("-o") + 1] if "-o" in argv else None


def emit(obj):
    print(json.dumps(obj), flush=True)


def write_files():
    if read_only():
        return
    spec = os.environ.get("FAKE_CODEX_WRITE", "")
    if spec.startswith("@"):  # read at call time, so a long-lived server can change it
        f = Path(spec[1:])
        spec = f.read_text() if f.exists() else ""
    for pair in filter(None, spec.split(";")):
        path, _, content = pair.partition("=")
        p = Path(path)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content)


def schema_keys():
    if "--output-schema" not in argv:
        return set()
    schema = json.loads(Path(argv[argv.index("--output-schema") + 1]).read_text())
    return set(schema.get("properties", {}))


def read_only():
    return ("-s" in argv and argv[argv.index("-s") + 1] == "read-only") or \
        'sandbox_mode="read-only"' in argv


def finish(status, files):
    keys = schema_keys()
    if "decision" in keys:
        decision, _, notes = os.environ.get("FAKE_CODEX_DECISION", "approve:looks good") \
            .partition(":")
        final = {"decision": decision, "notes": notes}
    elif "tasks" in keys:
        final = {"tasks": json.loads(os.environ.get("FAKE_CODEX_PLAN") or json.dumps([{
            "objective": "Set x to 2 in src/app.py", "context": "", "scope": "",
            "allowed_paths": ["src/**"], "excluded_paths": [],
            "acceptance_criteria": ["src/app.py contains x = 2"],
            "verification_commands": [], "depends_on": [], "risk_level": "low"}])),
            "notes": "fake plan"}
    else:
        final = {"status": status, "summary": f"fake {scenario}", "files_changed": files,
                 "tests_run": [], "notes": ""}
    text = json.dumps(final) if scenario != "nojson" else "not json"
    emit({"type": "item.completed", "item": {"id": "i1", "type": "agent_message", "text": text}})
    if out_file:
        Path(out_file).write_text(text)
    emit({"type": "turn.completed", "usage": {"input_tokens": 10, "output_tokens": 5}})
    sys.exit(0)


home = os.environ.get("CODEX_HOME")
key = hashlib.sha256(home.encode()).hexdigest() if home else "default"
sessions = state / "sessions" / f"{key}.txt"
sessions.parent.mkdir(exist_ok=True)
if resume and thread not in (sessions.read_text().splitlines() if sessions.exists() else []):
    emit({"type": "turn.failed", "error": {"message": "thread not found"}})
    sys.exit(1)
if not resume:
    with sessions.open("a") as f:
        f.write(thread + "\n")
if home and not (Path(home) / "auth.json").exists():
    scenario = "auth"

emit({"type": "thread.started", "thread_id": thread})
emit({"type": "turn.started"})
emit({"type": "item.completed", "item": {"id": "i0", "type": "error", "message": "hook noise"}})

if scenario == "slow":
    time.sleep(float(os.environ.get("FAKE_CODEX_SLOW", "2")))

if scenario in ("ok", "slow", "blocked", "nojson"):
    write_files()
    finish("completed" if scenario != "blocked" else "blocked", [])
elif scenario == "commit":
    write_files()
    subprocess.run(["git", "add", "-A"], check=True)
    subprocess.run(["git", "-c", "user.email=f@f", "-c", "user.name=f", "commit", "-qm", "x"],
                   check=True)
    finish("completed", [])
elif scenario == "outside":
    Path(os.environ["FAKE_CODEX_OUTSIDE"]).write_text("escaped")
    finish("completed", [])
elif scenario == "quota":
    emit({"type": "turn.failed", "error": {"message":
          "You've hit your usage limit. Upgrade to Pro or try again at 5:05 PM."}})
    sys.exit(1)
elif scenario == "auth":
    emit({"type": "error", "message": "unexpected status 401 Unauthorized: Missing bearer or "
          "basic authentication in header"})
    emit({"type": "turn.failed", "error": {"message": "unexpected status 401 Unauthorized"}})
    sys.exit(1)
elif scenario == "network":
    emit({"type": "turn.failed", "error": {"message":
          "stream disconnected before completion: error sending request"}})
    sys.exit(1)
elif scenario == "crash":
    print("thread 'main' panicked", file=sys.stderr)
    sys.exit(139)
elif scenario == "hang":
    child = subprocess.Popen(["sleep", "600"])
    (state / "child.pid").write_text(str(child.pid))
    (state / "self.pid").write_text(str(os.getpid()))
    time.sleep(600)
