{
  "sandbox": "workspace-write",
  "model": null,
  "codex_bin": "codex",
  "claude_bin": "claude",
  "opencode_bin": "opencode",
  "agy_bin": "agy",
  "ignore_user_config": true,
  "default_timeout_s": 1800,
  "max_timeout_s": 7200,
  "network_retries": 1,
  "retry_backoff_s": 10.0,
  "verify_timeout_s": 900,
  "verify_allowlist": [
    "pytest",
    "uv",
    "python",
    "python3",
    "ruff",
    "mypy",
    "make",
    "npm",
    "npx",
    "pnpm",
    "yarn",
    "node",
    "go",
    "cargo",
    "git",
    "true",
    "false"
  ],
  "protected_paths": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "*.pem",
    "*.key",
    "**/*.pem",
    "**/*.key",
    ".git/**",
    ".ai/**",
    ".mcp.json",
    ".claude/settings.json",
    ".claude/settings.local.json"
  ],
  "sensitive_paths": [
    "**/migrations/**",
    "migrations/**",
    "**/auth/**",
    "auth/**",
    "deploy/**",
    ".github/workflows/**",
    "**/*secret*",
    "**/*credential*",
    "Dockerfile",
    "**/Dockerfile"
  ],
  "env_deny": [
    "*_API_KEY",
    "*_TOKEN",
    "*_SECRET*",
    "*PASSWORD*",
    "AWS_*"
  ],
  "env_allow": [],
  "lock_dir": null
}
